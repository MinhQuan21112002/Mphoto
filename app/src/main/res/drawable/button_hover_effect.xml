<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái nhấn -->
    <item android:state_pressed="true" android:drawable="@color/hover_color" />
    <!-- Trạng thái focus hoặc hover -->
    <item android:state_focused="true" android:drawable="@color/hover_color" />
    <item android:state_hovered="true" android:drawable="@color/hover_color" />
    <!-- Trạng thái bình thường -->
    <item android:drawable="@color/normal_color" />
</selector>
