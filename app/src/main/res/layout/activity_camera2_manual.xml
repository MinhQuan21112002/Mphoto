<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mp_brand_screen"
        android:orientation="vertical"
        tools:context="com.sdk.esc.Activity_Camera2">

    <!-- Cột trái: vùng preview weight=1 lấp đủ chiều cao còn lại; list + in cố định phía dưới -->
    <LinearLayout
        android:id="@+id/left_camera_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/frame_layout_manual"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="@dimen/mono_left_col_padding"
        android:paddingEnd="@dimen/mono_left_col_padding"
        android:paddingTop="@dimen/mono_left_col_padding"
        android:paddingBottom="@dimen/mono_left_col_padding">

        <!-- Trong viền: live 4:3 theo ngang cột; ảnh phụ chiếm phần còn lại; nền đen -->
        <LinearLayout
            android:id="@+id/mono_preview_horizontal_block"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/mono_preview_min_height"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_up"
                android:layout_width="@dimen/mono_frame_nav_size"
                android:layout_height="@dimen/mono_frame_nav_size"
                android:layout_gravity="center_vertical"
                android:background="@drawable/mono_frame_nav_button_bg"
                android:contentDescription="@string/settings"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mono_frame_nav_chevron_left"
                app:tint="@color/mp_brand_text" />

            <FrameLayout
                android:id="@+id/mono_preview_center_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:background="@android:color/transparent">

                <!-- Tổng live 4:3 + ảnh phụ: host wrap, viền bám; hAvail từ cột giữa (code) -->
                <FrameLayout
                    android:id="@+id/mono_preview_flex_host"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:clipChildren="true">

                    <LinearLayout
                        android:id="@+id/mono_preview_flex_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="@drawable/mono_preview_block_framed"
                        android:clipChildren="true"
                        android:orientation="vertical"
                        android:padding="2dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#000000"
                            android:clipChildren="true">

                            <FrameLayout
                                android:id="@+id/live_preview_container"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:background="@drawable/mono_live_preview_frame"
                                android:clipChildren="true"
                                android:clipToPadding="true"
                                app:layout_constraintDimensionRatio="4:3"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextureView
                                    android:id="@+id/texture"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <ImageView
                                    android:id="@+id/imageView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter" />

                                <ImageView
                                    android:id="@+id/imageViewPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Photo Preview"
                                    android:scaleType="fitCenter"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/countdownTextManual"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="  3"
                                    android:textColor="#B0B0B0"
                                    android:textSize="96sp" />
                            </FrameLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <FrameLayout
                            android:id="@+id/frame_mono_second"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:background="#000000"
                            android:clipChildren="false"
                            android:minHeight="1dp">

                            <ImageView
                                android:id="@+id/imageViewSecond"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:adjustViewBounds="true"
                                android:contentDescription="Second Image"
                                android:minWidth="0dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/bottom" />
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Cột mũi tên phải: khoảng cách với preview; thêm khung sát trên, ô ảnh sát dưới, mũi tên giữa (Space + weight) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/mono_preview_trailing_gap"
                android:gravity="center_horizontal"
                android:minWidth="@dimen/mono_frame_nav_size"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/button_list"
                    android:layout_width="@dimen/mono_add_frame_btn_size"
                    android:layout_height="@dimen/mono_add_frame_btn_size"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/mono_nav_list_top_inset"
                    android:background="@drawable/mono_frame_nav_button_bg"
                    android:contentDescription="@string/settings"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/list2"
                    app:tint="@color/mp_brand_text" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/button_down"
                    android:layout_width="@dimen/mono_frame_nav_size"
                    android:layout_height="@dimen/mono_frame_nav_size"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/mono_frame_nav_button_bg"
                    android:contentDescription="@string/settings"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mono_frame_nav_chevron_right"
                    app:tint="@color/mp_brand_text" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.35" />

                <ImageView
                    android:id="@+id/imageMonoLatestThumb"
                    android:layout_width="@dimen/mono_thumb"
                    android:layout_height="@dimen/mono_thumb"
                    android:layout_gravity="center_horizontal|bottom"
                    android:background="@drawable/mono_folder_thumb_bg"
                    android:contentDescription="@string/mono_folder_thumb"
                    android:padding="2dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- In / Hủy sát dưới vùng live+ảnh phụ; không đẩy preview + ảnh phụ cùng cột list phía dưới -->
        <LinearLayout
            android:id="@+id/layout_print_cancel_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/mono_section_gap"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnCancel"
                style="@style/MonoPinkButtonSecondary"
                android:layout_width="@dimen/mono_print_btn_w"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:text="@string/Cancel" />

            <Button
                android:id="@+id/btnPrint"
                style="@style/MonoPinkButton"
                android:layout_width="@dimen/mono_print_btn_w"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/PrintImage" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cột phải: số, tải Drive, trở lại, đăng xuất (không còn preview) -->
    <FrameLayout
        android:id="@+id/frame_layout_manual"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="16dp"
        android:background="@drawable/mono_right_panel_bg"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/numberCount"
                android:textColor="@color/mp_brand_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnDecrease"
                    style="@style/MonoPinkButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/editTextNumber"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/mono_edittext"
                    android:editable="false"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="0"
                    android:textColor="@color/mp_brand_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btnIncrease"
                    style="@style/MonoPinkButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingTop="0dp"
                android:paddingBottom="4dp">

                <include layout="@layout/iso_exposure_columns" />
            </ScrollView>

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/mono_btn_primary"
                android:contentDescription="@string/settings"
                android:scaleType="centerCrop"
                android:src="@drawable/back2"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/button_settings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="@null"
        android:contentDescription="@string/settings"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_setting" />

    <ImageButton
        android:id="@+id/btnChangeLanguage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignStart="@+id/frame_layout_manual"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:layout_marginStart="228dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/language"
        app:tint="@color/mp_brand_primary" />
</RelativeLayout>
