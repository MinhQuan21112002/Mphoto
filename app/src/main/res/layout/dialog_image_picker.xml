<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mono_dialog_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickImage"
            style="@style/MonoPinkButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.8"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:maxLines="2"
            android:text="@string/SelectImageFromGalery"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/btnResyncMonoSubPhotos"
                style="@style/MonoPinkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:text="@string/mono_resync"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/subPhotoSyncSpinner"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:elevation="4dp"
                android:indeterminateTint="@color/mp_brand_primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewImages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLoadMoreSub"
            style="@style/MonoPinkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:minHeight="44dp"
            android:text="@string/load_more"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCloseSubPhotoDialog"
            style="@style/MonoPinkButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="72dp"
            android:text="@string/close"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
