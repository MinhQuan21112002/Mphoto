<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mono_dialog_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnCloseLanguage"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_select_language_title"
            android:textColor="@color/mp_brand_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseLanguage"
            style="@style/MonoPinkButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/close"
            android:textSize="13sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/btnLanguageVi"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/mono_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/flag_vietnam" />

        <TextView
            android:id="@+id/textLanguageVi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/vietnamese"
            android:textColor="@color/mp_brand_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnLanguageKo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/mono_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="25dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/flag_korea" />

        <TextView
            android:id="@+id/textLanguageKo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/korean"
            android:textColor="@color/mp_brand_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnLanguageEn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/mono_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/flag_english" />

        <TextView
            android:id="@+id/textLanguageEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/english"
            android:textColor="@color/mp_brand_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnLanguageZh"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/mono_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical|start"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/flag_china" />

        <TextView
            android:id="@+id/textLanguageZh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/chinese"
            android:textColor="@color/mp_brand_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
